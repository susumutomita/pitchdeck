{
  "name": "pitchdeck",
  "version": "1.0.0",
  "description": "A Claude Code skill that turns your repository into a keynote-quality pitch deck — and refuses to overclaim. Verifies every capability against the code path (function + test + wiring), not the README, and labels each one 実証済 / 実装中 / 構想.",
  "keywords": [
    "claude-code",
    "claude-code-skill",
    "pitch-deck",
    "slides",
    "presentation",
    "startup",
    "demo-day",
    "honest",
    "ai"
  ],
  "homepage": "https://github.com/susumutomita/pitchdeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/susumutomita/pitchdeck.git"
  },
  "author": "Susumu Tomita <oyster880@gmail.com>",
  "license": "MIT",
  "scripts": {
    "lint": "bun biome check .",
    "lint:fix": "bun biome check --write .",
    "lint:text": "bun textlint ./README.md",
    "lint-staged": "lint-staged",
    "format": "bun biome format --write .",
    "format:check": "bun biome format .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "rimraf": "^6.1.3",
    "textlint": "15.4.1",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.6.1",
    "textlint-rule-ja-no-abusage": "^3.0.0",
    "textlint-rule-ja-no-inappropriate-words": "^2.0.0",
    "textlint-rule-no-double-negative-ja": "^2.0.1",
    "textlint-rule-no-dropping-the-ra": "^3.0.0",
    "textlint-rule-prefer-tari-tari": "^1.0.3",
    "textlint-rule-preset-ja-spacing": "^2.2.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-spellcheck-tech-word": "^5.0.0"
  }
}
